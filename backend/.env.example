# Salin menjadi .env lalu isi nilainya. Berkas .env tidak ikut ke Git.
#
# Untuk deployment Docker, letakkan .env di root proyek (sejajar dengan
# docker-compose.yml). Untuk menjalankan backend langsung dengan npm, letakkan
# di dalam folder backend/.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000

# WAJIB diganti. Dipakai menandatangani token sesi dasbor.
# Buat nilai acak: openssl rand -base64 48
JWT_SECRET=ganti_dengan_nilai_acak_yang_panjang

# '*' atau daftar origin dipisah koma:
# CORS_ORIGIN=https://storage.contoh.com,http://192.168.1.10:5000
CORS_ORIGIN=*

# Batas ukuran satu berkas (byte). Default 500 MB.
# Catatan: proxy Cloudflare plan Free/Pro tetap menolak body di atas 100 MB.
MAX_UPLOAD_BYTES=524288000

# ---------------------------------------------------------------------------
# Database metadata: 'sqlite' (tanpa setup) atau 'mysql'
# ---------------------------------------------------------------------------
DB_CLIENT=sqlite

# Hanya dipakai saat DB_CLIENT=sqlite. Default: backend/data/database.sqlite
# SQLITE_FILE=data/database.sqlite

# Wajib saat DB_CLIENT=mysql.
# Dari dalam container, MySQL yang berjalan di host dijangkau lewat
# host.docker.internal (sudah dipetakan di docker-compose.yml).
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---------------------------------------------------------------------------
# Penyimpanan berkas: 'local' (disk) atau 'minio' / 's3'
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=minio

# Kredensial MinIO. Dipakai bersama oleh service minio dan aplikasi, jadi
# keduanya tidak mungkin berbeda.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=ganti_dengan_password_yang_kuat

S3_REGION=us-east-1
S3_BUCKET_PREFIX=gentan-

# Saat menjalankan backend di luar Docker, arahkan langsung ke MinIO:
# S3_ENDPOINT=http://localhost:9010
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=ganti_dengan_password_yang_kuat
# S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Port yang dipublikasikan ke host (khusus docker-compose)
# ---------------------------------------------------------------------------
APP_PORT=5000
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9001
