PORT=5000
JWT_SECRET=change_me_to_something_very_long_and_random_123456
CORS_ORIGIN=*

# Storage Settings: 'local' (local disk storage) or 'minio' / 's3' (MinIO/S3 compatible API)
STORAGE_PROVIDER=local

# MinIO / AWS S3 Configurations (Required only if STORAGE_PROVIDER is 'minio' or 's3')
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_PREFIX=gentan-
S3_FORCE_PATH_STYLE=true
